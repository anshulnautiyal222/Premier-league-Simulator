{
  "name": "gafferdex-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "GafferDex — The Fantasy Transfer & Club Exchange Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "powershell -Command \"cd apps/api; uvicorn app.main:app --reload --port 8000\"",
    "build:types": "npm run build --workspace=packages/shared-types",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:types && npm run build:web",
    "lint": "npm run lint --workspaces --if-present",
    "redis:up": "docker-compose up -d",
    "redis:down": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
