# ==============================================================================
# GafferDex Master Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================================================

# --- Port Configuration ---
PORT=3000
API_PORT=8000

# --- Supabase (PostgreSQL & Auth) ---
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Optional Direct Postgres Connection (for migrations / direct pooling)
DATABASE_URL=postgresql://postgres:your-super-secret-jwt-token-with-at-least-32-characters-long@aws-0-region.pooler.supabase.com:6543/postgres

# --- Redis (Caching, Tickers & Order Book Rate-Limiting) ---
# Default local docker-compose Redis connection
REDIS_URL=redis://localhost:6379/0

# --- Football Data Ingestion ---
# API Key for football stats (football-data.org or api-football.com)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# --- Market Engine Configuration ---
MARKET_BASE_SPREAD_PERCENT=3.0
MAX_DAILY_TRANSACTION_QUOTA=5
MIN_SQUAD_SIZE=11
MAX_SQUAD_SIZE=25
STARTING_PURSE_AMOUNT=150000000.00
